{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "composite": false,
    "allowJs": false,
    "checkJs": false,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "types": ["node", "./rstest.d.ts"]
  },
  "include": ["**/rspack.config.ts"],
  "exclude": ["node_modules", "**/dist", "js"]
}
