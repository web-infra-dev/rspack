var linkTag = document.createElement("link");
<%- _set_attributes %>
// Tag the link with its chunk identity so a later HMR update can still find it after
// its href changes (a hashed filename), when href-based lookup no longer matches.
linkTag.setAttribute("data-webpack-chunk", extractCssUniquePrefix + chunkId);
linkTag.rel = "stylesheet";
<% if (_set_linktype != "") { %>
linkTag.type = <%- _set_linktype %>;
<% } %>
if (<%- weak(SCRIPT_NONCE) %>) {
  linkTag.nonce = <%- weak(SCRIPT_NONCE) %>;
}
linkTag.href = fullhref;
<% if (_with_fetch_priority) { %>
if (fetchPriority) {
  linkTag.setAttribute("fetchpriority", fetchPriority);
}
<% } %>
<% if (_cross_origin == "use-credentials") { %>
linkTag.crossOrigin = "use-credentials";
<% } else if (_cross_origin != "") { %>
if (linkTag.href.indexOf(window.location.origin + '/') !== 0) {
  linkTag.crossOrigin = '<%- _cross_origin %>';
}
<% } %>
