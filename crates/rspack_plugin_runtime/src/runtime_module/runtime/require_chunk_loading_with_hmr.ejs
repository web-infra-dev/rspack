<%- fn("requireLoadUpdateChunk") %>(chunkId, updatedModulesList, full) {
	var filename = <%- GET_CHUNK_UPDATE_SCRIPT_FILENAME %>(chunkId);
	var update = require("<%- _output_dir %>" + filename + (full ? (/\.mjs$/.test(filename) ? ".full.mjs" : ".full.js") : ""));
	var updatedModules = update.modules;
	var runtime = update.runtime;
	for (var moduleId in updatedModules) {
		if (<%- HAS_OWN_PROPERTY %>(updatedModules, moduleId)) {
			// Install-only factories must not replace ordinary updates.
			if (!Array.isArray(updatedModules[moduleId]) || !<%- HAS_OWN_PROPERTY %>(hotCurrentUpdate, moduleId) || Array.isArray(hotCurrentUpdate[moduleId])) {
				hotCurrentUpdate[moduleId] = updatedModules[moduleId];
			}
			if (updatedModulesList) updatedModulesList.push(moduleId);
		}
	}
	if (runtime) hotCurrentUpdateRuntime.push(runtime);
}
