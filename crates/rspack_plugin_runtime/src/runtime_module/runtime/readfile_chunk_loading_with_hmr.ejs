<%- fn("readFileVmLoadUpdateChunk") %>(chunkId, updatedModulesList, full) {
	return new Promise(function(resolve, reject) {
		var filename = <%- GET_CHUNK_UPDATE_SCRIPT_FILENAME %>(chunkId);
		filename = require('path').join(__dirname, "<%- _output_dir %>" + filename + (full ? (/\.mjs$/.test(filename) ? ".full.mjs" : ".full.js") : ""));
		require('fs').readFile(filename, 'utf-8', function(err, content) {
			if(err) return reject(err);
			var update = {};
			require('vm').runInThisContext('(function(exports, require, __dirname, __filename) {' + content + '\n})', filename)(update, require, require('path').dirname(filename), filename);
			hotAddUpdateChunk(chunkId, update.modules, update.runtime, updatedModulesList, full);
			resolve();
		});
	});
}
