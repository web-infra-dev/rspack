// require() chunk loading for javascript
<%- ENSURE_CHUNK_HANDLERS %>.require = <%- basicFunction("chunkId, promises") %> {
	// "1" is the signal for "already loaded"
	var loader = <%- REQUIRE_SCOPE %>.nodeChunkLoader;
	if (loader.readFile && <%- _js_matcher %>) {
		var installed = requireInstalledChunks[chunkId];
		if (installed === 1) return;
		if (installed) return promises.push(installed[2]);
		var filename = require("path").join(__dirname, "<%- _output_dir %>" + <%- GET_CHUNK_SCRIPT_FILENAME %>(chunkId));
		// Keep local require chunks synchronous. The transport hook handles missing files.
		if (!require("fs").existsSync(filename)) {
			var generation = chunkCacheControls.require.getGeneration(chunkId);
			var promise = new Promise(function(resolve, reject) {
				installed = requireInstalledChunks[chunkId] = [resolve, reject];
				loader.readFile(filename, chunkId, function(error, content) {
					if (chunkCacheControls.require.isStale(chunkId, generation)) {
						error = new Error("Chunk " + chunkId + " is stale");
					}
					if (!error) {
						try {
							requireInstallChunk(loader.evaluate(filename, content));
							resolve();
							return;
						} catch (e) { error = e; }
					}
					if (requireInstalledChunks[chunkId] === installed) requireInstalledChunks[chunkId] = undefined;
					reject(error);
				});
			});
			promises.push(installed[2] = promise);
			return;
		}
	}
	if (!requireInstalledChunks[chunkId]) {
		if (<%- _js_matcher %>) {
			<% if (_with_hmr) { %>
			try {
				var filename = "<%- _output_dir %>" + <%- GET_CHUNK_SCRIPT_FILENAME %>(chunkId);
				if (require.cache) delete require.cache[require.resolve(filename)];
				requireInstallChunk(require(filename));
			} catch (error) {
				promises.push(Promise.reject(error));
			}
			<% } else { %>requireInstallChunk(require("<%- _output_dir %>" + <%- GET_CHUNK_SCRIPT_FILENAME %>(chunkId)));<% } %>
		} else requireInstalledChunks[chunkId] = 1;
	}
};
