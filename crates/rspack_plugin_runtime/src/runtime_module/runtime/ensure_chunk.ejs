<%- define(ENSURE_CHUNK) %> = <% if (_hmr) { %><%- basicFunction("chunkId, fetchPriority, skipGroup") %><% } else { %><%- basicFunction("chunkId" + _fetch_priority) %><% } %> {
	return Promise.all(
		Object.keys(<%- ENSURE_CHUNK_HANDLERS %>).reduce(<%- basicFunction("promises, key") %> {
			<% if (_hmr) { %>if (skipGroup && key === "group") return promises;
