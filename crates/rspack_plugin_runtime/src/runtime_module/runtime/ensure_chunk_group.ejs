<%- var("chunkGroups") %> = <%- _groups %>;
// undefined = not loaded, Promise = loading, 0 = loaded.
<%- var("installedChunkGroups") %> = <% if (_hmr) { %><%- _state_expression %> = <%- _state_expression %> || <% } %>Object.create(null);
<% if (_hmr) { %><%- var("hotUpdateChunkGroup") %>;
<% } %>
<%- define(ENSURE_CHUNK_GROUP) %> = <%- basicFunction("groupId, fetchPriority") %> {
	var promises = [];
	<% if (_hmr) { %>if (hotUpdateChunkGroup) hotUpdateChunkGroup(groupId, promises);
	<% } %>var chunks = chunkGroups[groupId] || [];
	chunks.forEach(<%- basicFunction("chunkId") %> {
		promises.push(<%- ENSURE_CHUNK %>(chunkId, fetchPriority));
	});
	var promise = Promise.all(promises);
	if (installedChunkGroups[groupId] !== 0) {
		installedChunkGroups[groupId] = promise;
		promise.then(<%- basicFunction("") %> {
			installedChunkGroups[groupId] = 0;
		}, <%- basicFunction("") %> {
			if (installedChunkGroups[groupId] === promise) delete installedChunkGroups[groupId];
		});
	}
	return promise;
};
<% if (_hmr) { %>
<%- HMR_DOWNLOAD_UPDATE_HANDLERS %>.chunkGroups = <%- basicFunction("chunkIds, removedChunks, removedModules, promises, applyHandlers, updatedModulesList, css, miniCss, update") %> {
	if (!update || !update.groups) return;
	hotUpdateChunkGroup = <%- basicFunction("groupId, promises") %> {
		var chunks = update.groups[groupId];
		if (!chunks) return;
		// Wait until all download handlers have registered their chunk preparers.
		promises.push(Promise.resolve().then(<%- basicFunction("") %> {
			var chunkPromises = [];
			chunks.forEach(<%- basicFunction("chunkId") %> {
				update.chunkHandlers.forEach(<%- basicFunction("handler") %> { handler(chunkId, chunkPromises); });
			});
			return Promise.all(chunkPromises);
		}));
	};
	Object.keys(installedChunkGroups).forEach(<%- basicFunction("groupId") %> {
		hotUpdateChunkGroup(groupId, promises);
	});
	applyHandlers.push(<%- basicFunction("") %> {
		hotUpdateChunkGroup = undefined;
		return {};
	});
};
<% } %>
