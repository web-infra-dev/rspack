		// here (an initial chunk gaining its first stylesheet, or a loaded async
		// chunk whose stylesheet an earlier update removed) gets a new stylesheet.
		if (!oldTag && (cssOnlyInitialChunkIds[chunkId] === 1 || !cssChunkIsLoaded(chunkId))) return;
