<%- var("currentModuleData") %> = {};
<%- var("hmrInstalledModules") %> = <%- MODULE_CACHE %>;

// module and require creation
<%- var("currentChildModule") %>;
<%- var("currentParents") %> = [];

// status
<%- var("registeredStatusHandlers") %> = [];
<%- var("currentStatus") %> = "idle";
<%- var("canHoldChunk") %> = false;

// while downloading
<%- var("blockingPromises") %> = 0;
<%- var("blockingPromisesWaiting") %> = [];
<%- var("blockingError") %>;

// The update info
<%- var("currentUpdateApplyHandlers") %>;
<%- var("queuedInvalidatedModules") %>;
// Chunk loads waiting for the current update to settle.
<%- var("settledWaiters") %> = [];
// Concurrent ensures share the actual attempt and its starting runtime hash.
<%- var("chunkLoadingPromises") %> = Object.create(null);

<%- define(HMR_MODULE_DATA) %> = currentModuleData;
<% if (_is_rspack_runtime_mode) { %><%- define(INTERCEPT_MODULE_EXECUTION) %> = [];
<% } %>
<%- INTERCEPT_MODULE_EXECUTION %>.push(function (options) {
	var module = options.module;
	var require = rspackHmrCreateRequire(options.require, options.id);
	module.hot = createModuleHotObject(options.id, module);
	module.parents = currentParents;
	module.children = [];
	currentParents = [];
	options.require = require;
	<% if (_is_rspack_runtime_mode) { %>options.context.r = require;
	Object.defineProperty(options.context, "e", {
		configurable: true,
		enumerable: true,
		writable: true,
		value: require.e
	});<% } %>
});

<%- define(HMR_DOWNLOAD_UPDATE_HANDLERS) %> = {};
<%- define(HMR_INVALIDATE_MODULE_HANDLERS) %> = {};
<%- define(HMR_CHECK_CHUNK) %> = function (chunkIds, version) {
	if (version === undefined) return;
	for (var i = 0; i < chunkIds.length; i++) {
		if (version !== <%- HMR_CHUNK_VERSIONS %>[chunkIds[i]]) {
			var error = new Error("Chunk is from another build (" + version + ")");
			error.name = "ChunkVersionError";
			return error;
		}
	}
};

<%- fn("rspackHmrCreateRequire") %>(require, moduleId) {
	var me = hmrInstalledModules[moduleId];
	if (!me) return require;
	var fn = function (request) {
		if (me.hot.active) {
			if (hmrInstalledModules[request]) {
				var parents = hmrInstalledModules[request].parents;
				if (parents.indexOf(moduleId) === -1) {
					parents.push(moduleId);
				}
			} else {
				currentParents = [moduleId];
				currentChildModule = request;
			}
			if (me.children.indexOf(request) === -1) {
				me.children.push(request);
			}
		} else {
			console.warn(
				"[HMR] unexpected require(" +
				request +
				") from disposed module " +
				moduleId
			);
			currentParents = [];
		}
		return require(request);
	};
	var createPropertyDescriptor = function (name) {
		return {
			configurable: true,
			enumerable: true,
			get: function () {
				return require[name];
			},
			set: function (value) {
				require[name] = value;
			}
		};
	};
	for (var name in require) {
		if (Object.prototype.hasOwnProperty.call(require, name) && name !== "e") {
			Object.defineProperty(fn, name, createPropertyDescriptor(name));
		}
	}

	fn.e = function (chunkId, fetchPriority) {
		var loading = chunkLoadingPromises[chunkId];
		if (loading) {
			if (loading[0]) trackBlockingPromise(loading[0]);
			return loading[1];
		}
		// [current download, complete retry]
		loading = [];
		var clear = function () {
			if (chunkLoadingPromises[chunkId] === loading) delete chunkLoadingPromises[chunkId];
		};
		var retriedHash;
		var load = function () {
			// Only one attempt blocks prepare; catch-up and retries must not.
			var hash = <%- GET_FULL_HASH %>();
			try {
				loading[0] = <% if (_is_rspack_runtime_mode) { %><%- REQUIRE_SCOPE %>.e<% } else { %>require.e<% } %>(chunkId, fetchPriority);
			} catch (error) {
				loading[0] = Promise.reject(error);
			}
			return trackBlockingPromise(loading[0]).then(function (result) {
				// Promise.all([]): every ensure handler found the chunk installed.
				// A ready handler can await this import without waiting for apply.
				if (!result || result.length === 0) return result;
				if (!canHoldChunk && currentStatus !== "abort" && currentStatus !== "fail") return result;
				return waitForUpdate().then(function () { return result; });
			}, function (error) {
				if (error.name !== "ChunkVersionError") throw error;
				return waitForUpdate(hash).then(function () {
					var nextHash = <%- GET_FULL_HASH %>();
					if (retriedHash === nextHash) throw error;
					retriedHash = nextHash;
					return load();
				});
			});
		};
		loading[1] = load();
		chunkLoadingPromises[chunkId] = loading;
		loading[1].then(clear, clear);
		return loading[1];
	};

	return fn;
}

<%- fn("createModuleHotObject") %>(moduleId, me) {
	var _main = currentChildModule !== moduleId;
	var hot = {
		_acceptedDependencies: {},
		_acceptedErrorHandlers: {},
		_declinedDependencies: {},
		_selfAccepted: false,
		_selfDeclined: false,
		_selfInvalidated: false,
		_disposeHandlers: [],
		_main: _main,
		_requireSelf: function () {
			currentParents = me.parents.slice();
			currentChildModule = _main ? undefined : moduleId;
			<%- REQUIRE %>(moduleId);
		},
		active: true,
		accept: function (dep, callback, errorHandler) {
			if (dep === undefined) hot._selfAccepted = true;
			else if (typeof dep === "function") hot._selfAccepted = dep;
			else if (typeof dep === "object" && dep !== null) {
				for (var i = 0; i < dep.length; i++) {
					hot._acceptedDependencies[dep[i]] = callback || function () { };
					hot._acceptedErrorHandlers[dep[i]] = errorHandler;
				}
			} else {
				hot._acceptedDependencies[dep] = callback || function () { };
				hot._acceptedErrorHandlers[dep] = errorHandler;
			}
		},
		decline: function (dep) {
			if (dep === undefined) hot._selfDeclined = true;
			else if (typeof dep === "object" && dep !== null)
				for (var i = 0; i < dep.length; i++)
					hot._declinedDependencies[dep[i]] = true;
			else hot._declinedDependencies[dep] = true;
		},
		dispose: function (callback) {
			hot._disposeHandlers.push(callback);
		},
		addDisposeHandler: function (callback) {
			hot._disposeHandlers.push(callback);
		},
		removeDisposeHandler: function (callback) {
			var idx = hot._disposeHandlers.indexOf(callback);
			if (idx >= 0) hot._disposeHandlers.splice(idx, 1);
		},
		invalidate: function () {
			this._selfInvalidated = true;
			switch (currentStatus) {
				case "idle":
					currentUpdateApplyHandlers = [];
					Object.keys(<%- HMR_INVALIDATE_MODULE_HANDLERS %>).forEach(function (key) {
						<%- HMR_INVALIDATE_MODULE_HANDLERS %>[key](moduleId, currentUpdateApplyHandlers);
					});
					setStatus("ready");
					break;
				case "ready":
					Object.keys(<%- HMR_INVALIDATE_MODULE_HANDLERS %>).forEach(function (key) {
						<%- HMR_INVALIDATE_MODULE_HANDLERS %>[key](moduleId, currentUpdateApplyHandlers);
					});
					break;
				case "prepare":
				case "check":
				case "dispose":
				case "apply":
					(queuedInvalidatedModules = queuedInvalidatedModules || []).push(
						moduleId
					);
					break;
				default:
					break;
			}
		},
		check: hotCheck,
		apply: hotApply,
		status: function (l) {
			if (!l) return currentStatus;
			registeredStatusHandlers.push(l);
		},
		addStatusHandler: function (l) {
			registeredStatusHandlers.push(l);
		},
		removeStatusHandler: function (l) {
			var idx = registeredStatusHandlers.indexOf(l);
			if (idx >= 0) registeredStatusHandlers.splice(idx, 1);
		},
		data: currentModuleData[moduleId]
	};
	currentChildModule = undefined;
	return hot;
}

<%- fn("setStatus") %>(newStatus) {
	currentStatus = newStatus;
	// Automatic checks also pass through ready before applying their update.
	if (newStatus !== "check" && newStatus !== "prepare" && newStatus !== "ready") canHoldChunk = false;
	<% if (_is_hot_test) { %>
	if (self.__HMR_UPDATED_RUNTIME__) {
		self.__HMR_UPDATED_RUNTIME__.statusPath.push(newStatus);
	}
	<% } %>
	var results = [];
	for (var i = 0; i < registeredStatusHandlers.length; i++)
		results[i] = registeredStatusHandlers[i].call(null, newStatus);
	if (newStatus === "idle" || newStatus === "abort" || newStatus === "fail") {
		var waiters = settledWaiters;
		settledWaiters = [];
		for (var j = 0; j < waiters.length; j++) waiters[j]();
	}

	return Promise.all(results).then(function () { });
}

<%- fn("unblock") %>() {
	if (--blockingPromises === 0 && currentStatus === "prepare") {
		// Change status synchronously, but propagate throws as promise rejections.
		return new Promise(function (resolve) {
			if (blockingError) throw blockingError;
			resolve(setStatus("ready"));
		}).then(function () {
			if (blockingPromises === 0) {
				var list = blockingPromisesWaiting;
				blockingPromisesWaiting = [];
				for (var i = 0; i < list.length; i++) {
					list[i].resolve();
				}
			}
		}, function (err) {
			var list = blockingPromisesWaiting;
			blockingPromisesWaiting = [];
			for (var i = 0; i < list.length; i++) list[i].reject(err);
			return setStatus("fail");
		});
	}
}

<%- fn("trackBlockingPromise") %>(promise, update) {
	switch (currentStatus) {
		case "ready":
			setStatus("prepare");
		case "prepare":
			blockingPromises++;
			// A ready handler may await this load, so the load must not await it.
			promise.then(unblock, function (error) {
				if (update) blockingError = error;
				return unblock();
			});
			return promise;
		default:
			return promise;
	}
}

<%- fn("waitForBlockingPromises") %>(fn) {
	if (blockingError) throw blockingError;
	if (blockingPromises === 0) return fn();
	return new Promise(function (resolve, reject) {
		blockingPromisesWaiting.push({ resolve: resolve, reject: reject });
	}).then(function () { return waitForBlockingPromises(fn); });
}

<%- fn("waitForUpdate") %>(hash) {
	if (currentStatus === "abort" || currentStatus === "fail") {
		return Promise.reject(new Error("Chunk loading failed because the update failed (" + currentStatus + ")"));
	}
	if (hash === undefined && !canHoldChunk) return Promise.resolve();
	if (currentStatus !== "idle") {
		return new Promise(function (resolve) { settledWaiters.push(resolve); }).then(function () {
			return waitForUpdate(hash);
		});
	}
	if (hash === undefined || hash !== <%- GET_FULL_HASH %>()) return Promise.resolve();
	return hotCheck(true).then(function (updatedModules) {
		if (!updatedModules) {
			throw new Error("Chunk is from another build, and no update leads to it");
		}
	});
}

<%- fn("hotCheck") %>(applyOnUpdate) {
	if (currentStatus !== "idle") {
		throw new Error("check() is only allowed in idle status");
	}
	canHoldChunk = Boolean(applyOnUpdate);
	blockingError = undefined;
	<% if (_is_hot_test) { %>
	self.__HMR_UPDATED_RUNTIME__ = {
		javascript: {
			outdatedModules: [],
			outdatedDependencies: [],

			acceptedModules: [],
			updatedModules: [],
			updatedRuntime: [],
			disposedModules: [],
		},
		statusPath: []
	};
	<% } %>
	return setStatus("check")
		.then(<%- HMR_DOWNLOAD_MANIFEST %>)
		.then(function (update) {
			if (!update) {
				canHoldChunk = false;
				return setStatus(applyInvalidatedModules() ? "ready" : "idle").then(
					function () {
						return null;
					}
				);
			}

			var updatedModules = [];
			// Preparation includes async status handlers and all update downloads.
			blockingPromises++;
			return Promise.resolve().then(function () {
				return setStatus("prepare");
			}).then(function () {
				currentUpdateApplyHandlers = [];

				return Promise.all(
					Object.keys(<%- HMR_DOWNLOAD_UPDATE_HANDLERS %>).reduce(function (
						promises,
						key
					) {
						<%- HMR_DOWNLOAD_UPDATE_HANDLERS %>[key](
							update.c,
							update.r,
							update.m,
							promises,
							currentUpdateApplyHandlers,
							updatedModules,
							update.css,
							update.miniCss,
							function (promise) { return trackBlockingPromise(promise, true); }
						);
						return promises;
					},
						[])
				);
			}).then(function () {
				blockingPromises--;
				return waitForBlockingPromises(function () {
					if (applyOnUpdate) {
						return internalApply(applyOnUpdate);
					}
					return setStatus("ready").then(function () {
						return updatedModules;
					});
				});
			}, function (err) {
				blockingPromises--;
				throw err;
			});
		}).catch(function (err) {
			// Wake imports when either the manifest or update preparation fails.
			if (currentStatus === "abort" || currentStatus === "fail") throw err;
			return setStatus("fail").then(function () { throw err; });
		});
}

<%- fn("hotApply") %>(options) {
	if (currentStatus !== "ready") {
		return Promise.resolve().then(function () {
			throw new Error(
				"apply() is only allowed in ready status (state: " + currentStatus + ")"
			);
		});
	}
	return internalApply(options);
}

<%- fn("internalApply") %>(options) {
	options = options || {};
	applyInvalidatedModules();
	var results = currentUpdateApplyHandlers.map(function (handler) {
		return handler(options);
	});
	currentUpdateApplyHandlers = undefined;
	var errors = results
		.map(function (r) {
			return r.error;
		})
		.filter(Boolean);

	if (errors.length > 0) {
		return setStatus("abort").then(function () {
			throw errors[0];
		});
	}

	var disposePromise = setStatus("dispose");

	results.forEach(function (result) {
		if (result.dispose) result.dispose();
	});

	var applyPromise = setStatus("apply");

	var error;
	var reportError = function (err) {
		if (!error) error = err;
	};

	var outdatedModules = [];
	results.forEach(function (result) {
		if (result.apply) {
			var modules = result.apply(reportError);
			if (modules) {
				for (var i = 0; i < modules.length; i++) {
					outdatedModules.push(modules[i]);
				}
			}
		}
	});

	return Promise.all([disposePromise, applyPromise]).then(function () {
		if (error) {
			return setStatus("fail").then(function () {
				throw error;
			});
		}

		if (queuedInvalidatedModules) {
			return internalApply(options).then(function (list) {
				outdatedModules.forEach(function (moduleId) {
					if (list.indexOf(moduleId) < 0) list.push(moduleId);
				});
				return list;
			});
		}

		return setStatus("idle").then(function () {
			return outdatedModules;
		});
	});
}

<%- fn("applyInvalidatedModules") %>() {
	if (queuedInvalidatedModules) {
		if (!currentUpdateApplyHandlers) currentUpdateApplyHandlers = [];
		Object.keys(<%- HMR_INVALIDATE_MODULE_HANDLERS %>).forEach(function (key) {
			queuedInvalidatedModules.forEach(function (moduleId) {
				<%- HMR_INVALIDATE_MODULE_HANDLERS %>[key](moduleId, currentUpdateApplyHandlers);
			});
		});
		queuedInvalidatedModules = undefined;
		return true;
	}
}
