{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "composite": false,
    "allowJs": false,
    "checkJs": false,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  "include": ["**/*.config.mts", "build/basic/entry.*.mts"],
  "exclude": [
    "node_modules",
    "**/node_modules",
    "**/dist",
    "build/config/cjs",
    "build/config/esm",
    "build/config/define-config",
    "build/config/monorepo"
  ]
}
