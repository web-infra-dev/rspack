{
  "name": "@rspack/cli",
  "version": "2.2.1",
  "description": "CLI for rspack",
  "homepage": "https://rspack.rs",
  "bugs": "https://github.com/web-infra-dev/rspack/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/web-infra-dev/rspack",
    "directory": "packages/rspack-cli"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "bin": {
    "rspack": "./bin/rspack.js"
  },
  "files": [
    "bin",
    "compiled",
    "dist"
  ],
  "scripts": {
    "build": "rs lib",
    "dev": "rs lib -w",
    "prepare": "prebundle",
    "test": "rs test"
  },
  "devDependencies": {
    "@discoveryjs/json-ext": "catalog:",
    "@microsoft/api-extractor": "catalog:",
    "@rstackjs/load-config": "catalog:",
    "@rspack/core": "workspace:*",
    "@rspack/dev-server": "catalog:",
    "cac": "catalog:",
    "concat-stream": "catalog:",
    "execa": "catalog:",
    "exit-hook": "catalog:",
    "jiti": "catalog:",
    "prebundle": "catalog:",
    "rspack-merge": "catalog:",
    "rstack": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@rspack/core": "^2.0.0-0",
    "@rspack/dev-server": "^2.0.0-0"
  },
  "peerDependenciesMeta": {
    "@rspack/dev-server": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
