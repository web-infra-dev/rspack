{
  "name": "@rspack/test-tools",
  "version": "2.2.6",
  "description": "Test tools for rspack",
  "homepage": "https://rspack.rs",
  "bugs": "https://github.com/web-infra-dev/rspack/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/web-infra-dev/rspack",
    "directory": "packages/rspack-test-tools"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./setup-expect": {
      "types": "./dist/helper/setup-expect.d.ts",
      "import": "./dist/helper/setup-expect.js",
      "require": "./dist/helper/setup-expect.cjs"
    },
    "./setup-env": {
      "types": "./dist/helper/setup-env.d.ts",
      "import": "./dist/helper/setup-env.js",
      "require": "./dist/helper/setup-env.cjs"
    },
    "./setup-wasm": {
      "types": "./dist/helper/setup-wasm.d.ts",
      "import": "./dist/helper/setup-wasm.js",
      "require": "./dist/helper/setup-wasm.cjs"
    },
    "./package.json": "./package.json",
    "./helper/*": {
      "types": "./dist/helper/*.d.ts",
      "import": "./dist/helper/*.js",
      "require": "./dist/helper/*.cjs"
    },
    "./helper/legacy/*": {
      "types": "./dist/helper/legacy/*.d.ts",
      "import": "./dist/helper/legacy/*.js",
      "require": "./dist/helper/legacy/*.cjs"
    },
    "./helper/util/*": {
      "types": "./dist/helper/util/*.d.ts",
      "import": "./dist/helper/util/*.js",
      "require": "./dist/helper/util/*.cjs"
    },
    "./reporter": {
      "types": "./dist/reporter/index.d.ts",
      "import": "./dist/reporter/index.js",
      "require": "./dist/reporter/index.cjs"
    },
    "./reporter/*": {
      "types": "./dist/reporter/*.d.ts",
      "import": "./dist/reporter/*.js",
      "require": "./dist/reporter/*.cjs"
    }
  },
  "types": "dist/index.d.ts",
  "files": [
    "client",
    "dist",
    "template",
    "rstest.d.ts"
  ],
  "scripts": {
    "build": "rs lib",
    "dev": "rs lib -w"
  },
  "dependencies": {
    "chalk": "catalog:",
    "filenamify": "catalog:",
    "fs-extra": "catalog:",
    "iconv-lite": "catalog:",
    "javascript-stringify": "catalog:",
    "jest-diff": "catalog:",
    "jsdom": "catalog:",
    "memfs": "catalog:",
    "path-serializer": "catalog:",
    "pretty-format": "catalog:",
    "rimraf": "catalog:",
    "rspack-merge": "catalog:",
    "source-map": "catalog:",
    "terser-webpack-plugin": "catalog:",
    "wast-loader": "catalog:"
  },
  "devDependencies": {
    "@rspack/core": "workspace:*",
    "@types/fs-extra": "catalog:",
    "@types/jsdom": "catalog:",
    "rstack": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@rspack/core": ">=1.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
