{
  "name": "@rspack/core",
  "version": "2.2.1",
  "webpackVersion": "5.75.0",
  "license": "MIT",
  "description": "Fast Rust-based bundler for the web with a modernized webpack API",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./hot/*": "./hot/*.js",
    "./hot/*.js": "./hot/*.js",
    "./package.json": "./package.json",
    "./module": "./module.d.ts"
  },
  "scripts": {
    "prepare": "prebundle && node ./move-tinypool.js",
    "build": "rs lib",
    "build:browser": "rs lib -c rstack.browser.config.ts",
    "dev": "rs lib --watch"
  },
  "files": [
    "dist",
    "hot",
    "compiled",
    "module.d.ts"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "homepage": "https://rspack.rs",
  "bugs": "https://github.com/web-infra-dev/rspack/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/web-infra-dev/rspack",
    "directory": "packages/rspack"
  },
  "devDependencies": {
    "@ast-grep/napi": "catalog:",
    "@napi-rs/wasm-runtime": "catalog:",
    "@rsbuild/plugin-node-polyfill": "catalog:",
    "@rspack/lite-tapable": "catalog:",
    "@swc/types": "catalog:",
    "@types/node": "catalog:",
    "browserslist-load-config": "catalog:",
    "browserslist-to-es-version": "catalog:",
    "connect-next": "catalog:",
    "enhanced-resolve": "catalog:",
    "http-proxy-middleware": "catalog:",
    "memfs": "catalog:",
    "open": "catalog:",
    "prebundle": "catalog:",
    "rstack": "catalog:",
    "tinypool": "catalog:",
    "typescript": "catalog:",
    "watchpack": "catalog:",
    "webpack-sources": "catalog:"
  },
  "dependencies": {
    "@rspack/binding": "workspace:*"
  },
  "peerDependencies": {
    "@module-federation/runtime-tools": "^0.24.1 || ^2.0.0",
    "@swc/helpers": "^0.5.23"
  },
  "peerDependenciesMeta": {
    "@module-federation/runtime-tools": {
      "optional": true
    },
    "@swc/helpers": {
      "optional": true
    }
  }
}
